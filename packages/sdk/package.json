{
  "name": "@mind2flow/agents-sdk",
  "version": "0.6.3",
  "description": "Official TypeScript SDK for the Mind2Flow AI agents platform",
  "keywords": [
    "ai",
    "agents",
    "mind2flow",
    "whatsapp",
    "automation",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pablocruzpineda/m2f-agents-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablocruzpineda/m2f-agents-sdk.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/pablocruzpineda/m2f-agents-sdk/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}')\"",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
